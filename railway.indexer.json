{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "railway.indexer.Dockerfile",
    "watchPatterns": [
      "/.dockerignore",
      "/deno.json",
      "/deno.lock",
      "/i18n/**",
      "/lexicons/**",
      "/lib/**",
      "/railway.indexer.Dockerfile",
      "/railway.indexer.json",
      "/scripts/migrate-db.ts",
      "/scripts/migrate-postgres.ts",
      "/scripts/prepare-postgres-release.ts",
      "/sql/**",
      "/utils.ts",
      "/worker/**"
    ]
  },
  "deploy": {
    "preDeployCommand": "deno task db:prepare:postgres"
  }
}
